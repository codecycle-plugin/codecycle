#!/bin/sh
# Starter für den Prüfer: liegt mit dem Plugin auf dem PATH des Bash-Werkzeugs, damit andere Plugins und
# Sitzungen ihn ohne Pfad aufrufen können. Gibt alle Argumente an skripte/pruefer.mjs weiter.
# Fehlt Node: Exit 2 mit Meldung, nicht der Exit-Code der Shell.
if ! command -v node >/dev/null 2>&1; then
  echo "Prüfer nicht gestartet: node fehlt"
  exit 2
fi
here=$(cd "$(dirname "$0")/.." && pwd)
exec node "$here/skripte/pruefer.mjs" "$@"
